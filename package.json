    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csv-parser": "3.0.0",
    "dotenv": "16.4.7",
    "exceljs": "4.4.0",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "nodemailer": "6.10.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "concurrently": "9.1.0"
  }
}
